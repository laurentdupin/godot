#!/usr/bin/env python
import os
import subprocess
import sys

from SCons.Script import Copy, Exit
from misc.utility.scons_hints import *

Import("env")
Import("env_modules")

env_html_css = env_modules.Clone()

_html_css_renderer = env["module_html_css_renderer"]

# Renderer-facing public headers and compile definitions must be present before
# any html_css object is created. Common module sources such as html_view.cpp
# include backend headers when HCSR is selected, so configuring only the
# backend-specific source block leaves those objects with an incomplete build
# environment on clean builds.
if _html_css_renderer in ("hcsr_old", "hcsr_old_dll"):
    if _html_css_renderer == "hcsr_old_dll" and (env["platform"] != "windows" or env["arch"] != "x86_64"):
        print("HTML/CSS hcsr_old_dll currently requires Windows x86_64.")
        Exit(1)
    env_html_css.Append(CPPDEFINES=["HTML_CSS_USE_HCSR"])
    if env["tests"]:
        env_html_css.Append(CPPDEFINES=["HTML_CSS_HCSR_TESTS_ENABLED"])
    env_html_css.Prepend(CPPPATH=["#thirdparty/hcsr_old/native/include"])
elif _html_css_renderer == "hcsr_runtime":
    if env["platform"] != "windows" or env["arch"] != "x86_64":
        print("HTML/CSS hcsr_runtime validation currently requires Windows x86_64 and Godot's D3D12 driver.")
        Exit(1)
    runtime_root_option = env["module_html_css_hcsr_runtime_root"]
    if not runtime_root_option:
        print("module_html_css_hcsr_runtime_root must identify the current HCSR checkout.")
        Exit(1)
    hcsr_runtime_root = os.path.normpath(runtime_root_option)
    if not os.path.isabs(hcsr_runtime_root):
        hcsr_runtime_root = env.Dir("#" + hcsr_runtime_root).abspath
    runtime_header = os.path.join(hcsr_runtime_root, "native", "include", "hcsr_runtime.h")
    runtime_project = os.path.join(
        hcsr_runtime_root,
        "src",
        "Renderer.PresentationNativeBridge",
        "Renderer.PresentationNativeBridge.Shared.csproj",
    )
    runtime_output = os.path.join(
        hcsr_runtime_root,
        "src",
        "Renderer.PresentationNativeBridge",
        "bin",
        "Release",
        "net10.0",
        "win-x64",
    )
    runtime_import_library = os.path.join(runtime_output, "native", "hcsr_runtime.lib")
    runtime_publish_directory = os.path.join(runtime_output, "publish")
    runtime_library = os.path.join(runtime_publish_directory, "hcsr_runtime.dll")
    runtime_codecs = os.path.join(runtime_publish_directory, "hcsr_native_codecs.dll")
    # The header, import library, and runtime DLL are one ABI product. Rebuild
    # that product when any replacement-runtime source is newer, then let SCons
    # copy the resulting DLLs by timestamp. This keeps incremental builds cached
    # without allowing an older runtime DLL beside a newer Godot module.
    runtime_source_directories = [
        os.path.join(hcsr_runtime_root, "native", "codecs"),
        os.path.join(hcsr_runtime_root, "native", "include"),
        os.path.join(hcsr_runtime_root, "src"),
    ]
    runtime_input_extensions = (".c", ".cpp", ".cs", ".csproj", ".def", ".h", ".props", ".targets")
    runtime_input_files = []
    for source_directory in runtime_source_directories:
        for directory, subdirectories, filenames in os.walk(source_directory):
            subdirectories[:] = [name for name in subdirectories if name not in ("bin", "obj")]
            runtime_input_files += [
                os.path.join(directory, filename)
                for filename in filenames
                if filename.lower().endswith(runtime_input_extensions)
            ]
    runtime_input_files += [
        os.path.join(hcsr_runtime_root, filename)
        for filename in ("Directory.Build.props", "Directory.Build.targets", "global.json")
        if os.path.isfile(os.path.join(hcsr_runtime_root, filename))
    ]
    runtime_products = (runtime_import_library, runtime_library, runtime_codecs)
    runtime_publish_stamp = os.path.join(runtime_publish_directory, ".godot_hcsr_runtime_publish.stamp")
    runtime_publish_required = not all(os.path.isfile(path) for path in runtime_products)
    runtime_publish_required = runtime_publish_required or not os.path.isfile(runtime_publish_stamp)
    if not runtime_publish_required and runtime_input_files:
        newest_input_time = max(os.path.getmtime(path) for path in runtime_input_files)
        runtime_publish_required = newest_input_time > os.path.getmtime(runtime_publish_stamp)
    if runtime_publish_required:
        completed = subprocess.run(
            [
                "dotnet",
                "publish",
                runtime_project,
                "-c",
                "Release",
                "-r",
                "win-x64",
                "--self-contained",
                "--nologo",
            ],
            cwd=hcsr_runtime_root,
        )
        if completed.returncode != 0:
            print("HTML/CSS hcsr_runtime NativeAOT publish failed.")
            Exit(1)
        with open(runtime_publish_stamp, "w", encoding="utf-8") as stamp_file:
            stamp_file.write("Godot HCSR runtime ABI product is current.\n")
    if not all(os.path.isfile(path) for path in (runtime_header, runtime_import_library, runtime_library, runtime_codecs)):
        print("HTML/CSS hcsr_runtime publish did not produce its header, import library, runtime DLL, and codec DLL.")
        Exit(1)
    env_html_css.Append(CPPDEFINES=["HTML_CSS_USE_HCSR_RUNTIME"])
    env_html_css.Prepend(CPPPATH=[os.path.join(hcsr_runtime_root, "native", "include")])

def _html_css_resolve_repo_path(p_path):
    if not p_path:
        return ""
    if os.path.isabs(p_path):
        return os.path.normpath(p_path)
    if p_path.startswith("#"):
        return env.Dir(p_path).abspath
    return env.Dir("#" + p_path).abspath


def _html_css_resolve_repo_file(p_path):
    if not p_path:
        return ""
    if os.path.isabs(p_path):
        return os.path.normpath(p_path)
    if p_path.startswith("#"):
        return env.File(p_path).abspath
    return env.File("#" + p_path).abspath


def _html_css_hcsr_static_library_path():
    if env["module_html_css_hcsr_lib_path"]:
        return _html_css_resolve_repo_file(env["module_html_css_hcsr_lib_path"])
    if env["platform"] == "android":
        android_rid = "linux-bionic-arm64" if env["arch"] == "arm64" else "linux-bionic-x64"
        return _html_css_resolve_repo_file(
            os.path.join(
                "thirdparty",
                "hcsr_old",
                "src",
                "Renderer.NativeBridge",
                "bin",
                "Release",
                "net10.0",
                android_rid,
                "publish",
                "hcsr_renderer_android_combined.a",
            )
        )
    if env["platform"] == "linuxbsd":
        linux_rid = "linux-arm64" if env["arch"] == "arm64" else "linux-x64"
        return _html_css_resolve_repo_file(
            os.path.join(
                "thirdparty",
                "hcsr_old",
                "src",
                "Renderer.NativeBridge",
                "bin",
                "Release",
                "net10.0",
                linux_rid,
                "publish",
                "hcsr_renderer_combined.a",
            )
        )
    if env["platform"] == "macos":
        macos_rid = "osx-arm64" if env["arch"] == "arm64" else "osx-x64"
        return _html_css_resolve_repo_file(
            os.path.join(
                "thirdparty",
                "hcsr_old",
                "src",
                "Renderer.NativeBridge",
                "bin",
                "Release",
                "net10.0",
                macos_rid,
                "publish",
                "hcsr_renderer_combined.a",
            )
        )
    windows_rid = "win-arm64" if env["arch"] == "arm64" else "win-x64"
    return _html_css_resolve_repo_file(
        os.path.join(
            "thirdparty",
            "hcsr_old",
            "src",
            "Renderer.NativeBridge",
            "bin",
            "Release",
            "net10.0",
            windows_rid,
            "publish",
            "hcsr_renderer_combined.lib",
        )
    )


def _html_css_ensure_hcsr_static_library():
    supported_arch = env["arch"] in ("x86_64", "arm64")
    supported_target = supported_arch and env["platform"] in ("windows", "android", "linuxbsd", "macos")
    if env["platform"] == "linuxbsd" and not sys.platform.startswith("linux"):
        supported_target = False
    if not supported_target:
        print("HTML/CSS HCSR supports Windows, Linux, and macOS x86_64/ARM64 plus Android x86_64/ARM64 targets. BSD is not supported.")
        Exit(1)

    library_path = _html_css_hcsr_static_library_path()
    hcsr_root = _html_css_resolve_repo_path(os.path.join("thirdparty", "hcsr_old"))
    initializer_name = "hcsr_renderer_android_initializer.o" if env["platform"] == "android" else "hcsr_renderer_initializer.o"
    initializer_path = os.path.join(os.path.dirname(library_path), initializer_name)
    required_package_files = [library_path]
    if env["platform"] != "windows":
        required_package_files.append(initializer_path)
    if env["platform"] == "android":
        required_package_files.append(os.path.join(os.path.dirname(library_path), "hcsr_native_codecs_android.a"))
    package_is_current = all(os.path.isfile(path) for path in required_package_files)
    if package_is_current and not env["module_html_css_hcsr_lib_path"]:
        marker_name = "hcsr_renderer_android.commit" if env["platform"] == "android" else "hcsr_renderer_combined.commit"
        marker_path = os.path.join(os.path.dirname(library_path), marker_name)
        source_commit = subprocess.run(
            ["git", "-C", hcsr_root, "rev-parse", "HEAD"],
            capture_output=True,
            text=True,
        )
        packaged_commit = ""
        if os.path.isfile(marker_path):
            with open(marker_path, "r", encoding="utf-8") as marker_file:
                packaged_commit = marker_file.read().strip()
        package_is_current = source_commit.returncode == 0 and packaged_commit == source_commit.stdout.strip()
    if package_is_current and not env["module_html_css_hcsr_lib_path"]:
        # A commit marker cannot detect edited-but-uncommitted renderer sources.
        # Compare product inputs with the archive as well so an ordinary Godot
        # rebuild cannot silently link a stale HCSR implementation.
        hcsr_input_extensions = (".c", ".cpp", ".cs", ".csproj", ".h", ".props", ".ps1", ".targets")
        hcsr_input_directories = [
            os.path.join(hcsr_root, "native", "codecs"),
            os.path.join(hcsr_root, "native", "include"),
            os.path.join(hcsr_root, "src"),
            os.path.join(hcsr_root, "tools"),
        ]
        newest_hcsr_input_time = 0.0
        for source_directory in hcsr_input_directories:
            if not os.path.isdir(source_directory):
                continue
            for directory, subdirectories, filenames in os.walk(source_directory):
                subdirectories[:] = [name for name in subdirectories if name not in ("bin", "build", "obj")]
                for filename in filenames:
                    if filename.lower().endswith(hcsr_input_extensions):
                        newest_hcsr_input_time = max(
                            newest_hcsr_input_time,
                            os.path.getmtime(os.path.join(directory, filename)),
                        )
        for filename in ("Directory.Build.props", "Directory.Build.targets", "global.json"):
            input_path = os.path.join(hcsr_root, filename)
            if os.path.isfile(input_path):
                newest_hcsr_input_time = max(newest_hcsr_input_time, os.path.getmtime(input_path))
        package_is_current = newest_hcsr_input_time <= os.path.getmtime(library_path)
    if package_is_current:
        return
    if not env["module_html_css_hcsr_auto_build"] or env["module_html_css_hcsr_lib_path"]:
        print("HTML/CSS HCSR static library is missing: " + library_path)
        Exit(1)

    if env["platform"] == "android":
        build_script = _html_css_resolve_repo_file(os.path.join("thirdparty", "hcsr_old", "tools", "build-android-native.ps1"))
        android_abi = "arm64-v8a" if env["arch"] == "arm64" else "x86_64"
        print("HTML/CSS HCSR Android archive is missing or stale; building nested %s NativeAOT bridge:" % android_abi)
        print("  " + build_script)
        completed = subprocess.run(
            [
                "powershell",
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                build_script,
                "-AndroidSdkRoot",
                env["ANDROID_HOME"],
                "-AndroidNdkRoot",
                env["ANDROID_NDK_ROOT"],
                "-AndroidAbi",
                android_abi,
            ],
            cwd=hcsr_root,
        )
    elif env["platform"] in ("linuxbsd", "macos"):
        build_script = _html_css_resolve_repo_file(os.path.join("thirdparty", "hcsr_old", "tools", "build-unix-native.sh"))
        target_platform = "linux" if env["platform"] == "linuxbsd" else "macos"
        target_architecture = "arm64" if env["arch"] == "arm64" else "x86_64"
        print("HTML/CSS HCSR %s archive is missing or stale; building nested %s NativeAOT bridge:" % (target_platform, target_architecture))
        print("  " + build_script)
        completed = subprocess.run(
            ["bash", build_script, "--platform", target_platform, "--architecture", target_architecture],
            cwd=hcsr_root,
        )
    else:
        build_script = _html_css_resolve_repo_file(os.path.join("thirdparty", "hcsr_old", "tools", "build-windows-native.ps1"))
        codec_build_script = _html_css_resolve_repo_file(os.path.join("thirdparty", "hcsr_old", "tools", "build-native-codecs.ps1"))
        target_architecture = "arm64" if env["arch"] == "arm64" else "x86_64"
        print("HTML/CSS HCSR Windows archive is missing or stale; building nested %s NativeAOT bridge:" % target_architecture)
        print("  " + build_script)
        # The frozen old build expects the host codec DLL to exist while it
        # publishes the final static archive, even though that DLL is removed
        # from the package afterward. Prepare that input without modifying the
        # pinned old source tree.
        completed = subprocess.run(
            [
                "powershell",
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                codec_build_script,
                "-RepositoryRoot",
                hcsr_root,
            ],
            cwd=hcsr_root,
        )
        if completed.returncode == 0:
            completed = subprocess.run(
                ["powershell", "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", build_script, "-Architecture", target_architecture],
                cwd=hcsr_root,
            )
    if completed.returncode != 0 or not os.path.isfile(library_path):
        print("HTML/CSS HCSR NativeAOT publish failed or did not produce its combined static library.")
        print("  " + library_path)
        Exit(1)

    if env["platform"] != "windows" and not os.path.isfile(initializer_path):
        print("HTML/CSS HCSR NativeAOT initializer object is missing: " + initializer_path)
        Exit(1)
    if env["platform"] == "android":
        codec_path = os.path.join(os.path.dirname(library_path), "hcsr_native_codecs_android.a")
        if not os.path.isfile(codec_path):
            print("HTML/CSS HCSR Android codec retention archive is missing: " + codec_path)
            Exit(1)


def _html_css_hcsr_old_shared_products():
    hcsr_root = _html_css_resolve_repo_path(os.path.join("thirdparty", "hcsr_old"))
    output_root = os.path.join(
        hcsr_root,
        "src",
        "Renderer.NativeBridge",
        "bin",
        "Release",
        "net10.0",
        "win-x64",
    )
    return (
        hcsr_root,
        os.path.join(output_root, "native", "hcsr_renderer.lib"),
        os.path.join(output_root, "publish", "hcsr_renderer.dll"),
        os.path.join(output_root, "publish", "hcsr_renderer.godot.commit"),
    )


def _html_css_ensure_hcsr_old_shared_library():
    hcsr_root, import_library, runtime_library, marker_path = _html_css_hcsr_old_shared_products()
    source_commit = subprocess.run(
        ["git", "-C", hcsr_root, "rev-parse", "HEAD"],
        capture_output=True,
        text=True,
    )
    packaged_commit = ""
    if os.path.isfile(marker_path):
        with open(marker_path, "r", encoding="utf-8") as marker_file:
            packaged_commit = marker_file.read().strip()
    package_is_current = (
        source_commit.returncode == 0
        and packaged_commit == source_commit.stdout.strip()
        and os.path.isfile(import_library)
        and os.path.isfile(runtime_library)
    )
    if package_is_current:
        return
    if not env["module_html_css_hcsr_auto_build"]:
        print("HTML/CSS HCSR shared library is missing or stale: " + runtime_library)
        Exit(1)

    codec_build_script = _html_css_resolve_repo_file(
        os.path.join("thirdparty", "hcsr_old", "tools", "build-native-codecs.ps1")
    )
    shared_project = os.path.join(
        hcsr_root,
        "src",
        "Renderer.NativeBridge",
        "Renderer.NativeBridge.Shared.csproj",
    )
    print("HTML/CSS HCSR old Windows DLL is missing or stale; publishing the pinned NativeAOT bridge:")
    print("  " + shared_project)
    completed = subprocess.run(
        [
            "powershell",
            "-NoProfile",
            "-ExecutionPolicy",
            "Bypass",
            "-File",
            codec_build_script,
            "-RepositoryRoot",
            hcsr_root,
        ],
        cwd=hcsr_root,
    )
    if completed.returncode == 0:
        completed = subprocess.run(
            [
                "dotnet",
                "publish",
                shared_project,
                "-c",
                "Release",
                "-r",
                "win-x64",
                "--self-contained",
                "--nologo",
            ],
            cwd=hcsr_root,
        )
    if completed.returncode != 0 or not os.path.isfile(import_library) or not os.path.isfile(runtime_library):
        print("HTML/CSS HCSR old shared NativeAOT publish failed.")
        Exit(1)
    with open(marker_path, "w", encoding="utf-8") as marker_file:
        marker_file.write(source_commit.stdout.strip() + "\n")


