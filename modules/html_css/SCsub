#!/usr/bin/env python
import json
import os
import shutil
import subprocess
import zipfile

from SCons.Script import Exit
from misc.utility.scons_hints import *

Import("env")
Import("env_modules")

env_html_css = env_modules.Clone()

_html_css_renderer = env["module_html_css_renderer"]
if env["module_html_css_blink_enabled"]:
    if _html_css_renderer == "hcsr":
        print("HTML/CSS renderer selection is contradictory: module_html_css_blink_enabled=yes cannot be combined with module_html_css_renderer=hcsr.")
        Exit(1)
    _html_css_renderer = "blink"

_html_css_blink_package_path_override = bool(env["module_html_css_blink_lib_path"])


def _html_css_resolve_repo_path(p_path):
    if not p_path:
        return ""
    if os.path.isabs(p_path):
        return os.path.normpath(p_path)
    if p_path.startswith("#"):
        return env.Dir(p_path).abspath
    return env.Dir("#" + p_path).abspath


def _html_css_resolve_repo_file(p_path):
    if not p_path:
        return ""
    if os.path.isabs(p_path):
        return os.path.normpath(p_path)
    if p_path.startswith("#"):
        return env.File(p_path).abspath
    return env.File("#" + p_path).abspath


def _html_css_hcsr_static_library_path():
    if env["module_html_css_hcsr_lib_path"]:
        return _html_css_resolve_repo_file(env["module_html_css_hcsr_lib_path"])
    return _html_css_resolve_repo_file(
        os.path.join(
            "thirdparty",
            "hcsr",
            "src",
            "Renderer.NativeBridge",
            "bin",
            "Release",
            "net10.0",
            "win-x64",
            "publish",
            "Renderer.NativeBridge.lib",
        )
    )


def _html_css_ensure_hcsr_static_library():
    if env["platform"] != "windows" or env["arch"] != "x86_64":
        print("HTML/CSS HCSR currently supports only Windows x86_64 Godot hosts.")
        Exit(1)

    library_path = _html_css_hcsr_static_library_path()
    if os.path.isfile(library_path):
        return
    if not env["module_html_css_hcsr_auto_build"] or env["module_html_css_hcsr_lib_path"]:
        print("HTML/CSS HCSR static library is missing: " + library_path)
        Exit(1)

    project_path = _html_css_resolve_repo_file(
        os.path.join("thirdparty", "hcsr", "src", "Renderer.NativeBridge", "Renderer.NativeBridge.csproj")
    )
    print("HTML/CSS HCSR static library is missing; publishing nested NativeAOT bridge:")
    print("  " + project_path)
    completed = subprocess.run(
        ["dotnet", "publish", project_path, "-c", "Release", "-r", "win-x64", "--nologo"],
        cwd=_html_css_resolve_repo_path(os.path.join("thirdparty", "hcsr")),
    )
    if completed.returncode != 0 or not os.path.isfile(library_path):
        print("HTML/CSS HCSR NativeAOT publish failed or did not produce: " + library_path)
        Exit(1)


def _html_css_default_blink_package_path():
    package_kind = "c_api_static" if env["module_html_css_blink_link_mode"] == "static" else "c_api_runtime"
    build_dir = _html_css_blink_build_dir(_html_css_blink_package_profile())
    return os.path.join(
        "thirdparty",
        "blink-standalone-ui",
        "build",
        build_dir,
        "package",
        package_kind,
    )


def _html_css_package_artifact(p_package_path):
    if env["module_html_css_blink_link_mode"] == "static":
        return os.path.join(p_package_path, "blink_standalone_renderer_c_api_static_link_manifest.json")
    return os.path.join(p_package_path, env["module_html_css_blink_lib"])


def _html_css_blink_build_dir(p_profile):
    if env["platform"] == "windows" and p_profile == "msvc" and env["module_html_css_blink_link_mode"] == "static":
        return "cmake-msvc-static-proof"
    if env["platform"] == "windows" and p_profile == "msvc":
        return "cmake-msvc-release"
    return "cmake-generated-v8-chromium-llvm"


def _html_css_blink_prebuilt_key(p_profile):
    key = "%s-%s-%s" % (env["platform"], env["arch"], p_profile)
    if env["module_html_css_blink_link_mode"] == "static":
        key += "-static"
    return key


def _html_css_prebuilt_package_path_for_profile(p_profile):
    package_kind = "c_api_static" if env["module_html_css_blink_link_mode"] == "static" else "c_api_runtime"
    return _html_css_resolve_repo_path(
        os.path.join(
            env["module_html_css_blink_package_root"],
            _html_css_blink_prebuilt_key(p_profile),
            package_kind,
        )
    )


def _html_css_prebuilt_profile_dir_for_profile(p_profile):
    return _html_css_resolve_repo_path(
        os.path.join(
            env["module_html_css_blink_package_root"],
            _html_css_blink_prebuilt_key(p_profile),
        )
    )


def _html_css_prebuilt_archive_for_profile(p_profile):
    profile_dir = _html_css_prebuilt_profile_dir_for_profile(p_profile)
    if not os.path.isdir(profile_dir):
        return ""
    archives = [
        os.path.join(profile_dir, entry)
        for entry in os.listdir(profile_dir)
        if os.path.isfile(os.path.join(profile_dir, entry)) and os.path.splitext(entry)[1].lower() == ".zip"
    ]
    if len(archives) > 1:
        print("HTML/CSS Blink found multiple local package archives; specify module_html_css_blink_lib_path or keep exactly one archive:")
        for archive in sorted(archives):
            print("  " + archive)
        Exit(1)
    if len(archives) == 1:
        return archives[0]
    return ""


def _html_css_archive_extract_root(p_archive_path, p_profile):
    archive_stem = os.path.splitext(os.path.basename(p_archive_path))[0]
    return _html_css_resolve_repo_path(
        os.path.join(
            "bin",
            ".html_css_blink_runtime",
            _html_css_blink_prebuilt_key(p_profile),
            archive_stem,
        )
    )


def _html_css_archive_package_path_for_profile(p_profile):
    archive_path = _html_css_prebuilt_archive_for_profile(p_profile)
    if not archive_path:
        return ""
    return _html_css_extracted_package_path(_html_css_archive_extract_root(archive_path, p_profile))


def _html_css_default_blink_package_path_for_profile(p_profile):
    package_kind = "c_api_static" if env["module_html_css_blink_link_mode"] == "static" else "c_api_runtime"
    return _html_css_resolve_repo_path(
        os.path.join(
            "thirdparty",
            "blink-standalone-ui",
            "build",
            _html_css_blink_build_dir(p_profile),
            "package",
            package_kind,
        )
    )


def _html_css_dynamic_artifact_for_profile(p_profile):
    build_artifact = _html_css_package_artifact(_html_css_default_blink_package_path_for_profile(p_profile))
    if os.path.exists(build_artifact):
        return build_artifact
    prebuilt_artifact = _html_css_package_artifact(_html_css_prebuilt_package_path_for_profile(p_profile))
    if os.path.exists(prebuilt_artifact):
        return prebuilt_artifact
    archive_package_path = _html_css_archive_package_path_for_profile(p_profile)
    if archive_package_path:
        return _html_css_package_artifact(archive_package_path)
    return _html_css_package_artifact(_html_css_default_blink_package_path_for_profile(p_profile))


def _html_css_profile_has_dynamic_package(p_profile):
    if os.path.exists(_html_css_package_artifact(_html_css_default_blink_package_path_for_profile(p_profile))):
        return True
    if os.path.exists(_html_css_package_artifact(_html_css_prebuilt_package_path_for_profile(p_profile))):
        return True
    if _html_css_prebuilt_archive_for_profile(p_profile):
        return True
    return False


def _html_css_blink_package_profile():
    profile = env["module_html_css_blink_package_profile"]
    if profile != "auto":
        return profile
    if env["module_html_css_blink_link_mode"] == "dynamic":
        for candidate in ("msvc", "generated_v8_chromium_llvm"):
            if _html_css_profile_has_dynamic_package(candidate):
                return candidate
    if env["platform"] == "windows":
        return "msvc"
    return "generated_v8_chromium_llvm"


def _html_css_blink_package_path():
    if env["module_html_css_blink_lib_path"]:
        return _html_css_resolve_repo_path(env["module_html_css_blink_lib_path"])
    profile = _html_css_blink_package_profile()
    build_output_path = _html_css_default_blink_package_path_for_profile(profile)
    if os.path.exists(_html_css_package_artifact(build_output_path)):
        return build_output_path
    prebuilt_path = _html_css_prebuilt_package_path_for_profile(profile)
    if os.path.exists(_html_css_package_artifact(prebuilt_path)):
        return prebuilt_path
    archive_package_path = _html_css_archive_package_path_for_profile(profile)
    if archive_package_path:
        return archive_package_path
    return _html_css_resolve_repo_path(_html_css_default_blink_package_path())


def _html_css_link_input(p_link_input):
    if os.path.isabs(p_link_input):
        return p_link_input
    if os.path.dirname(p_link_input):
        return _html_css_resolve_repo_path(p_link_input)
    return os.path.join(_html_css_blink_package_path(), p_link_input)


def _html_css_split_link_inputs(p_link_inputs):
    return [link_input.strip() for link_input in p_link_inputs.split(";") if link_input.strip()]


def _html_css_append_unique(r_link_inputs, p_link_inputs):
    for link_input in p_link_inputs:
        if link_input and link_input not in r_link_inputs:
            r_link_inputs.append(link_input)


def _html_css_static_manifest_path():
    manifest_path = env["module_html_css_blink_static_manifest"]
    if manifest_path:
        return _html_css_resolve_repo_path(manifest_path)
    return os.path.join(_html_css_blink_package_path(), "blink_standalone_renderer_c_api_static_link_manifest.json")


def _html_css_load_static_manifest():
    manifest_path = _html_css_static_manifest_path()
    if not manifest_path or not os.path.isfile(manifest_path):
        return None
    with open(manifest_path, "r", encoding="utf-8-sig") as manifest_file:
        return json.load(manifest_file)


def _html_css_static_manifest_allows_host_link(p_manifest):
    if not p_manifest:
        return True
    if p_manifest.get("full_host_static_link_supported") is False:
        return False
    symbol_ownership = p_manifest.get("symbol_ownership", {})
    if symbol_ownership.get("product_supported") is False:
        return False
    return True


def _html_css_validate_static_manifest_host_link(p_manifest):
    if env["module_html_css_blink_static_allow_unsupported_host"]:
        return
    if _html_css_static_manifest_allows_host_link(p_manifest):
        return

    print("HTML/CSS Blink static package declares full host/editor static linking unsupported:")
    print("  manifest: " + _html_css_static_manifest_path())
    if p_manifest.get("full_host_static_link_blocker"):
        print("  blocker: " + p_manifest["full_host_static_link_blocker"])
    symbol_ownership = p_manifest.get("symbol_ownership", {})
    if symbol_ownership.get("required_resolution"):
        print("  required resolution: " + symbol_ownership["required_resolution"])
    print("Set module_html_css_blink_static_allow_unsupported_host=yes only for local experimental diagnostics.")
    Exit(1)


def _html_css_static_manifest_code_sidecars(p_manifest):
    if not p_manifest:
        return []

    code_sidecar_extensions = (".dll", ".so", ".dylib")
    blocked_sidecars = []
    for key in ("remaining_runtime_sidecars", "package_files"):
        for entry in p_manifest.get(key, []):
            if os.path.splitext(entry)[1].lower() in code_sidecar_extensions:
                blocked_sidecars.append(entry)
    return sorted(set(blocked_sidecars))


def _html_css_validate_static_manifest_runtime_sidecars(p_manifest):
    blocked_sidecars = _html_css_static_manifest_code_sidecars(p_manifest)
    if not blocked_sidecars:
        return

    print("HTML/CSS Blink static package requires code shared-library runtime sidecars:")
    print("  manifest: " + _html_css_static_manifest_path())
    for sidecar in blocked_sidecars:
        print("  sidecar: " + sidecar)
    print("Static mode must not require Blink/ANGLE code DLL/SO/DYLIB sidecars. Use a full-static Blink package, or explicitly opt into dynamic diagnostic mode.")
    Exit(1)


def _html_css_runtime_manifest_path():
    return os.path.join(_html_css_blink_package_path(), "blink_standalone_renderer_c_api_link_manifest.json")


def _html_css_load_runtime_manifest():
    manifest_path = _html_css_runtime_manifest_path()
    if not manifest_path or not os.path.isfile(manifest_path):
        return None
    with open(manifest_path, "r", encoding="utf-8-sig") as manifest_file:
        return json.load(manifest_file)


def _html_css_runtime_sidecar_target_entry(p_entry):
    normalized_entry = os.path.normpath(p_entry)
    parts = normalized_entry.split(os.sep)
    if parts and parts[0].lower() == "bin":
        if len(parts) == 1:
            return ""
        return os.path.join(*parts[1:])
    return normalized_entry


def _html_css_should_copy_runtime_sidecar(p_entry):
    extension = os.path.splitext(p_entry)[1].lower()
    return extension not in (".a", ".exp", ".h", ".hpp", ".lib", ".obj", ".pdb", ".zip")


def _html_css_expected_package_artifact():
    return _html_css_package_artifact(_html_css_blink_package_path())


def _html_css_blink_auto_build_commands():
    profile = _html_css_blink_package_profile()
    if env["module_html_css_blink_link_mode"] == "static":
        if profile == "msvc" and env["platform"] == "windows":
            return [
                [
                    "powershell",
                    "-NoProfile",
                    "-ExecutionPolicy",
                    "Bypass",
                    "-File",
                    "upstream\\chromium\\standalone_renderer\\tools\\build_msvc_static_package.ps1",
                    "-SkipV8Build",
                    "-SkipDawnBuild",
                    "-Jobs",
                    "8",
                ],
            ]
        return []

    if profile == "msvc":
        return [
            ["cmake", "--preset", "x64-Release-MSVC"],
            ["cmake", "--build", "--preset", "x64-Release-MSVC-c-api-package", "--parallel", "8"],
        ]
    if profile == "generated_v8_chromium_llvm":
        return [
            ["cmake", "--preset", "x64-Release-GeneratedV8"],
            ["cmake", "--build", "--preset", "x64-Release-GeneratedV8-v8-compat", "--parallel", "8"],
            ["cmake", "--preset", "x64-Release-GeneratedV8-ChromiumLLVM"],
            ["cmake", "--build", "--preset", "x64-Release-GeneratedV8-ChromiumLLVM-c-api-package", "--parallel", "8"],
        ]
    return []


def _html_css_command_text(p_command):
    return " ".join(p_command)


def _html_css_print_package_build_help():
    print("HTML/CSS Blink package artifact is missing:")
    print("  " + _html_css_expected_package_artifact())
    if not _html_css_blink_package_path_override:
        profile = _html_css_blink_package_profile()
        print("Checked nested package paths:")
        print("  build output: " + _html_css_default_blink_package_path_for_profile(profile))
        print("  optional local artifact cache: " + _html_css_prebuilt_package_path_for_profile(profile))
        print("  optional local archive cache: " + _html_css_prebuilt_profile_dir_for_profile(profile))
    print("Build it from the nested checkout:")
    commands = _html_css_blink_auto_build_commands()
    if env["module_html_css_blink_link_mode"] == "static":
        print("  cd thirdparty\\blink-standalone-ui")
        if commands:
            for command in commands:
                print("  " + _html_css_command_text(command))
        else:
            print("  Build the nested static package output for this platform first, or pass module_html_css_blink_lib_path/module_html_css_blink_static_manifest explicitly.")
        return
    print("  cd thirdparty\\blink-standalone-ui")
    for command in commands:
        print("  " + _html_css_command_text(command))


def _html_css_ensure_blink_package():
    if _html_css_renderer != "blink" or _html_css_blink_package_path_override:
        return

    _html_css_extract_prebuilt_archive_if_needed()
    expected_artifact = _html_css_expected_package_artifact()
    if os.path.exists(expected_artifact):
        return

    if not env["module_html_css_blink_auto_build"]:
        _html_css_print_package_build_help()
        Exit(1)

    commands = _html_css_blink_auto_build_commands()
    if not commands:
        _html_css_print_package_build_help()
        Exit(1)

    nested_blink_dir = env.Dir("#thirdparty/blink-standalone-ui").abspath
    print("HTML/CSS Blink package artifact is missing; building nested Blink package:")
    print("  " + expected_artifact)
    child_env = os.environ.copy()
    child_env.setdefault("DEPOT_TOOLS_WIN_TOOLCHAIN", "0")
    for command in commands:
        print("  " + _html_css_command_text(command))
        completed = subprocess.run(command, cwd=nested_blink_dir, env=child_env)
        if completed.returncode != 0:
            print("HTML/CSS Blink package auto-build failed with exit code %d." % completed.returncode)
            print("Run the nested package command manually, or retry with module_html_css_blink_auto_build=yes after preparing network/depot_tools/CIPD prerequisites.")
            Exit(completed.returncode)

    if not os.path.exists(expected_artifact):
        print("HTML/CSS Blink package auto-build completed, but the expected artifact is still missing:")
        print("  " + expected_artifact)
        Exit(1)


def _html_css_archive_marker_path(p_extract_root):
    return os.path.join(p_extract_root, ".archive_state.json")


def _html_css_archive_state(p_archive_path):
    archive_stat = os.stat(p_archive_path)
    return {
        "archive": os.path.abspath(p_archive_path),
        "size": archive_stat.st_size,
        "mtime": int(archive_stat.st_mtime),
    }


def _html_css_archive_state_matches(p_marker_path, p_archive_path):
    if not os.path.isfile(p_marker_path):
        return False
    try:
        with open(p_marker_path, "r", encoding="utf-8-sig") as marker_file:
            marker_state = json.load(marker_file)
    except Exception:
        return False
    return marker_state == _html_css_archive_state(p_archive_path)


def _html_css_safe_extract_archive(p_archive_path, p_extract_root):
    extract_root = os.path.abspath(p_extract_root)
    with zipfile.ZipFile(p_archive_path, "r") as archive:
        for member in archive.infolist():
            member_path = os.path.normpath(os.path.join(extract_root, member.filename))
            member_root = os.path.normcase(os.path.abspath(member_path))
            if os.path.commonpath([os.path.normcase(extract_root), member_root]) != os.path.normcase(extract_root):
                print("HTML/CSS Blink archive contains an unsafe path and will not be extracted: " + member.filename)
                Exit(1)
        archive.extractall(extract_root)


def _html_css_extracted_package_path(p_extract_root):
    package_kind = "c_api_static" if env["module_html_css_blink_link_mode"] == "static" else "c_api_runtime"
    direct_package_path = os.path.join(p_extract_root, package_kind)
    if os.path.exists(_html_css_package_artifact(direct_package_path)):
        return direct_package_path
    if os.path.exists(_html_css_package_artifact(p_extract_root)):
        return p_extract_root
    return direct_package_path


def _html_css_extract_prebuilt_archive_if_needed():
    if _html_css_blink_package_path_override:
        return
    profile = _html_css_blink_package_profile()
    build_output_path = _html_css_default_blink_package_path_for_profile(profile)
    if os.path.exists(_html_css_package_artifact(build_output_path)):
        return
    prebuilt_path = _html_css_prebuilt_package_path_for_profile(profile)
    if os.path.exists(_html_css_package_artifact(prebuilt_path)):
        return
    archive_path = _html_css_prebuilt_archive_for_profile(profile)
    if not archive_path:
        return

    extract_root = _html_css_archive_extract_root(archive_path, profile)
    package_path = _html_css_extracted_package_path(extract_root)
    marker_path = _html_css_archive_marker_path(extract_root)
    if os.path.exists(_html_css_package_artifact(package_path)) and _html_css_archive_state_matches(marker_path, archive_path):
        return

    if os.path.isdir(extract_root):
        shutil.rmtree(extract_root)
    os.makedirs(extract_root, exist_ok=True)
    _html_css_safe_extract_archive(archive_path, extract_root)
    package_path = _html_css_extracted_package_path(extract_root)
    if not os.path.exists(_html_css_package_artifact(package_path)):
        print("HTML/CSS Blink archive extraction did not produce the expected C API package:")
        print("  archive: " + archive_path)
        print("  expected: " + _html_css_package_artifact(package_path))
        Exit(1)
    with open(marker_path, "w", encoding="utf-8") as marker_file:
        json.dump(_html_css_archive_state(archive_path), marker_file, indent=2, sort_keys=True)
    print("HTML/CSS Blink extracted package archive to " + package_path)


def _html_css_copy_runtime_sidecars():
    if not env["module_html_css_blink_copy_runtime_sidecars"]:
        return

    package_path = _html_css_blink_package_path()
    if not os.path.isdir(package_path):
        return

    if env["module_html_css_blink_link_mode"] == "static":
        package_manifest = _html_css_load_static_manifest()
    else:
        package_manifest = _html_css_load_runtime_manifest()

    if package_manifest and package_manifest.get("package_schema_version"):
        metadata = []
        if package_manifest.get("blink_commit"):
            metadata.append("commit=" + package_manifest["blink_commit"])
        build_metadata = package_manifest.get("build", {})
        if build_metadata.get("profile"):
            metadata.append("profile=" + build_metadata["profile"])
        if metadata:
            print("HTML/CSS Blink package metadata: " + " ".join(metadata))

    bin_dir = env.Dir("#bin").abspath
    package_root = os.path.normcase(os.path.abspath(package_path))
    os.makedirs(bin_dir, exist_ok=True)
    copied_count = 0

    copy_entries = []
    if env["module_html_css_blink_link_mode"] == "static":
        if package_manifest and package_manifest.get("remaining_runtime_sidecars"):
            copy_entries = package_manifest.get("remaining_runtime_sidecars", [])
        elif package_manifest and package_manifest.get("package_files"):
            copy_entries = [
                entry
                for entry in package_manifest.get("package_files", [])
                if os.path.normpath(entry).split(os.sep)[0].lower() == "bin"
            ]
        else:
            package_bin_dir = os.path.join(package_path, "bin")
            if os.path.isdir(package_bin_dir):
                copy_entries = [os.path.join("bin", entry) for entry in os.listdir(package_bin_dir)]
    elif package_manifest and package_manifest.get("package_files"):
        copy_entries = package_manifest.get("package_files", [])
    elif package_manifest and package_manifest.get("runtime_sidecars_package_relative"):
        artifacts = package_manifest.get("artifacts", {})
        if artifacts.get("dll"):
            copy_entries.append(artifacts["dll"])
        copy_entries += package_manifest.get("runtime_sidecars_package_relative", [])
        copy_entries.append("blink_standalone_renderer_c_api_link_manifest.json")

    if not copy_entries:
        copy_entries = os.listdir(package_path)

    for entry in copy_entries:
        source_path = os.path.normpath(os.path.join(package_path, entry))
        if os.path.isabs(entry):
            continue
        source_root = os.path.normcase(os.path.abspath(source_path))
        if os.path.commonpath([package_root, source_root]) != package_root:
            continue
        if not os.path.isfile(source_path):
            continue
        if not _html_css_should_copy_runtime_sidecar(entry):
            continue
        target_entry = _html_css_runtime_sidecar_target_entry(entry)
        if not target_entry:
            continue
        target_path = os.path.normpath(os.path.join(bin_dir, target_entry))
        target_root = os.path.normcase(os.path.abspath(target_path))
        if os.path.commonpath([os.path.normcase(bin_dir), target_root]) != os.path.normcase(bin_dir):
            continue
        os.makedirs(os.path.dirname(target_path), exist_ok=True)
        if os.path.exists(target_path):
            source_stat = os.stat(source_path)
            target_stat = os.stat(target_path)
            if source_stat.st_size == target_stat.st_size and int(source_stat.st_mtime) == int(target_stat.st_mtime):
                continue
        shutil.copy2(source_path, target_path)
        copied_count += 1
    if copied_count:
        print("HTML/CSS Blink copied %d runtime sidecar(s) to %s" % (copied_count, bin_dir))


def _html_css_manifest_link_inputs(p_manifest):
    link_inputs = []
    whole_archive_candidates = set(p_manifest.get("whole_archive_candidates_msvc", []))
    use_whole_archive = env["module_html_css_blink_static_whole_archive"]

    for key in ("required_static_archives", "required_import_libraries", "third_party_static_archives"):
        for link_input in p_manifest.get(key, []):
            resolved_link_input = link_input
            if not os.path.isabs(link_input):
                resolved_link_input = os.path.join(_html_css_blink_package_path(), link_input)
            if use_whole_archive and link_input in whole_archive_candidates and env["platform"] == "windows":
                _html_css_append_unique(link_inputs, ["/WHOLEARCHIVE:" + resolved_link_input])
            else:
                _html_css_append_unique(link_inputs, [resolved_link_input])

    _html_css_append_unique(link_inputs, p_manifest.get("windows_system_libraries", []))
    return link_inputs


