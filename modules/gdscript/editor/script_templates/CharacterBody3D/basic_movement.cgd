// meta-description: Classic movement for gravity games (FPS, TPS, ...)
extends _BASE_;

const dynamic SPEED = 5.0;
const dynamic JUMP_VELOCITY = 4.5;

void _physics_process(float delta) {
    if (!is_on_floor()) {
        velocity += get_gravity() * delta;
    }
    if (Input.is_action_just_pressed("ui_accept") && is_on_floor()) {
        velocity.y = JUMP_VELOCITY;
    }
    // Replace UI actions with custom gameplay actions for your game.
    auto input_dir = Input.get_vector("ui_left", "ui_right", "ui_up", "ui_down");
    auto direction = (transform.basis * Vector3(input_dir.x, 0, input_dir.y)).normalized();
    if (direction) {
        velocity.x = direction.x * SPEED;
        velocity.z = direction.z * SPEED;
    } else {
        velocity.x = move_toward(velocity.x, 0, SPEED);
        velocity.z = move_toward(velocity.z, 0, SPEED);
    }
    move_and_slide();
}
