#!/usr/bin/env python
import os
import shutil
import subprocess
import sys

from SCons.Script import Exit
from misc.utility.scons_hints import *

Import("env")
Import("env_modules")

env_html_css = env_modules.Clone()
_html_css_renderer = env["module_html_css_renderer"]


def _html_css_resolve_repo_path(path):
    if not path:
        return ""
    if os.path.isabs(path):
        return os.path.normpath(path)
    if path.startswith("#"):
        return env.Dir(path).abspath
    return env.Dir("#" + path).abspath


def _html_css_resolve_repo_file(path):
    if not path:
        return ""
    if os.path.isabs(path):
        return os.path.normpath(path)
    if path.startswith("#"):
        return env.File(path).abspath
    return env.File("#" + path).abspath


def _html_css_runtime_identifier():
    architecture = "arm64" if env["arch"] == "arm64" else "x64"
    if env["platform"] == "windows":
        return "win-" + architecture
    if env["platform"] == "linuxbsd":
        return "linux-" + architecture
    if env["platform"] == "macos":
        return "osx-" + architecture
    return ""


def _html_css_runtime_paths():
    runtime_identifier = _html_css_runtime_identifier()
    output_root = _html_css_resolve_repo_path(
        os.path.join(
            "thirdparty",
            "hcsr",
            "src",
            "Renderer.PresentationNativeBridge",
            "bin",
            "Release",
            "net10.0",
            runtime_identifier,
        )
    )
    if env["platform"] == "windows":
        return (
            os.path.join(output_root, "native", "hcsr_runtime.lib"),
            os.path.join(output_root, "publish", "hcsr_runtime.dll"),
        )
    if env["platform"] == "linuxbsd":
        shared_library = os.path.join(output_root, "publish", "hcsr_runtime.so")
        return (shared_library, shared_library)
    shared_library = os.path.join(output_root, "publish", "hcsr_runtime.dylib")
    return (shared_library, shared_library)


def _html_css_ensure_hcsr_runtime():
    if env["arch"] not in ("x86_64", "arm64") or env["platform"] not in ("windows", "linuxbsd", "macos"):
        print("HTML/CSS RuntimeSession integration currently supports Windows, Linux, and macOS x86_64/ARM64.")
        Exit(1)
    if env["platform"] == "linuxbsd" and not sys.platform.startswith("linux"):
        print("HTML/CSS Linux RuntimeSession packages must be built on Linux.")
        Exit(1)

    link_library, shared_library = _html_css_runtime_paths()
    if env["module_html_css_hcsr_lib_path"]:
        link_library = _html_css_resolve_repo_file(env["module_html_css_hcsr_lib_path"])
        shared_override = os.path.splitext(link_library)[0] + (".dll" if env["platform"] == "windows" else (".so" if env["platform"] == "linuxbsd" else ".dylib"))
        if os.path.isfile(shared_override):
            shared_library = shared_override

    hcsr_root = _html_css_resolve_repo_path(os.path.join("thirdparty", "hcsr"))
    marker_path = os.path.join(os.path.dirname(shared_library), "hcsr_runtime.commit")
    source_commit = subprocess.run(["git", "-C", hcsr_root, "rev-parse", "HEAD"], capture_output=True, text=True)
    source_commit_text = source_commit.stdout.strip() if source_commit.returncode == 0 else ""
    packaged_commit = ""
    if os.path.isfile(marker_path):
        with open(marker_path, "r", encoding="utf-8") as marker_file:
            packaged_commit = marker_file.read().strip()
    package_is_current = os.path.isfile(link_library) and os.path.isfile(shared_library) and packaged_commit == source_commit_text

    if not package_is_current:
        if not env["module_html_css_hcsr_auto_build"] or env["module_html_css_hcsr_lib_path"]:
            print("HTML/CSS RuntimeSession library is missing or stale: " + link_library)
            Exit(1)
        project = os.path.join(
            hcsr_root,
            "src",
            "Renderer.PresentationNativeBridge",
            "Renderer.PresentationNativeBridge.Shared.csproj",
        )
        command = [
            "dotnet",
            "publish",
            project,
            "-c",
            "Release",
            "-r",
            _html_css_runtime_identifier(),
            "--self-contained",
            "--nologo",
        ]
        print("HTML/CSS RuntimeSession package is missing or stale; publishing the frozen native ABI:")
        print("  " + " ".join(command))
        completed = subprocess.run(command, cwd=hcsr_root)
        if completed.returncode != 0 or not os.path.isfile(link_library) or not os.path.isfile(shared_library):
            print("HTML/CSS RuntimeSession NativeAOT publish failed.")
            Exit(1)
        with open(marker_path, "w", encoding="utf-8") as marker_file:
            marker_file.write(source_commit_text)

    bin_directory = _html_css_resolve_repo_path("bin")
    os.makedirs(bin_directory, exist_ok=True)
    deployed_library = os.path.join(bin_directory, os.path.basename(shared_library))
    if not os.path.isfile(deployed_library) or os.path.getmtime(deployed_library) < os.path.getmtime(shared_library):
        shutil.copy2(shared_library, deployed_library)

    return link_library, shared_library, deployed_library


if _html_css_renderer == "hcsr":
    env_html_css.Append(CPPDEFINES=["HTML_CSS_USE_HCSR"])
    if env["tests"]:
        env_html_css.Append(CPPDEFINES=["HTML_CSS_HCSR_TESTS_ENABLED"])
    env_html_css.Prepend(CPPPATH=["#thirdparty/hcsr/native/include"])

env_html_css.add_source_files(env.modules_sources, "bridge/html_activation_engine.cpp")
env_html_css.add_source_files(env.modules_sources, "bridge/html_asset_provider.cpp")
env_html_css.add_source_files(env.modules_sources, "bridge/html_source_validator.cpp")
env_html_css.add_source_files(env.modules_sources, "backend/html_surface_cpu_backend.cpp")
env_html_css.add_source_files(env.modules_sources, "backend/html_surface_unsupported_backend.cpp")

if _html_css_renderer == "hcsr":
    hcsr_link_library, hcsr_shared_library, hcsr_deployed_library = _html_css_ensure_hcsr_runtime()
    print("HTML/CSS RuntimeSession library: " + hcsr_link_library)
    hcsr_module_sources = []
    env_html_css.add_source_files(hcsr_module_sources, "backend/hcsr_performance_monitor.cpp")
    env_html_css.add_source_files(hcsr_module_sources, "backend/html_surface_hcsr_backend.cpp")
    env.Depends(hcsr_module_sources, [hcsr_link_library, hcsr_shared_library, hcsr_deployed_library])
    env.modules_sources += hcsr_module_sources
    if env["platform"] == "windows":
        env.Append(LINKFLAGS=[hcsr_link_library])
    elif env["platform"] == "linuxbsd":
        env.Append(LINKFLAGS=[hcsr_link_library, "-Wl,-rpath,$ORIGIN"])
    else:
        env.Append(LINKFLAGS=[hcsr_link_library, "-Wl,-rpath,@executable_path"])

env_html_css.add_source_files(env.modules_sources, "html_document.cpp")
env_html_css.add_source_files(env.modules_sources, "html_render_target.cpp")
env_html_css.add_source_files(env.modules_sources, "html_render_surface.cpp")
env_html_css.add_source_files(env.modules_sources, "html_texture.cpp")
env_html_css.add_source_files(env.modules_sources, "html_view.cpp")
env_html_css.add_source_files(env.modules_sources, "html_view_output.cpp")
env_html_css.add_source_files(env.modules_sources, "register_types.cpp")

if not env["disable_3d"]:
    env_html_css.add_source_files(env.modules_sources, "html_surface_3d.cpp")
